diff --git a/src/cmake/build_minizip-ng.cmake b/src/cmake/build_minizip-ng.cmake
index eddc034..eaa51af 100644
--- a/src/cmake/build_minizip-ng.cmake
+++ b/src/cmake/build_minizip-ng.cmake
@@ -18,6 +18,12 @@ set_cache (minizip-ng_BUILD_SHARED_LIBS OFF
 checked_find_package (ZLIB REQUIRED)
 
 
+if (ZLIB_LIBRARIES)
+    string(REPLACE ";" "|" ZLIB_LIBRARIES_ESCAPED "${ZLIB_LIBRARIES}")
+endif()
+if (ZLIB_INCLUDE_DIRS)
+    string(REPLACE ";" "|" ZLIB_INCLUDE_DIRS_ESCAPED "${ZLIB_INCLUDE_DIRS}")
+endif()
 build_dependency_with_cmake(minizip-ng
     VERSION         ${minizip-ng_BUILD_VERSION}
     GIT_REPOSITORY  ${minizip-ng_GIT_REPOSITORY}
@@ -27,11 +33,6 @@ build_dependency_with_cmake(minizip-ng
         -D BUILD_SHARED_LIBS=${minizip-ng_BUILD_SHARED_LIBS}
         -D CMAKE_POSITION_INDEPENDENT_CODE=ON
         -D CMAKE_INSTALL_LIBDIR=lib
-        # Since the other modules create a subfolder for the includes by default and since
-        # minizip-ng does not, a suffix is added to CMAKE_INSTALL_INCLUDEDIR in order to
-        # install the headers under a subdirectory named "minizip-ng".
-        # Note that this does not affect external builds for minizip-ng.
-        -D CMAKE_INSTALL_INCLUDEDIR=${CMAKE_INSTALL_INCLUDEDIR}/minizip-ng
         -D MZ_OPENSSL=OFF
         -D MZ_LIBBSD=OFF
         -D MZ_BUILD_TESTS=OFF
@@ -47,13 +48,44 @@ build_dependency_with_cmake(minizip-ng
         -D MZ_ICONV=OFF
         -D MZ_FETCH_LIBS=OFF
         -D MZ_FORCE_FETCH_LIBS=OFF
-        -D ZLIB_LIBRARY=${ZLIB_LIBRARIES}
-        -D ZLIB_INCLUDE_DIR=${ZLIB_INCLUDE_DIRS}
+        -D ZLIB_LIBRARY=${ZLIB_LIBRARIES_ESCAPED}
+        -D ZLIB_INCLUDE_DIR=${ZLIB_INCLUDE_DIRS_ESCAPED}
     )
 
 
-set (minizip-ng_DIR ${minizip-ng_LOCAL_INSTALL_DIR}/lib/cmake/minizip-ng)
+set (_minizip-ng_CONFIG_DIR ${minizip-ng_LOCAL_INSTALL_DIR}/lib/cmake/minizip)
+set (_minizip-ng_LIB_DIR ${minizip-ng_LOCAL_INSTALL_DIR}/lib)
+set (minizip-ng_DIR ${_minizip-ng_CONFIG_DIR})
 set (minizip-ng_VERSION ${minizip-ng_BUILD_VERSION})
 set (minizip-ng_REFIND TRUE)
 set (minizip-ng_REFIND_VERSION ${minizip-ng_BUILD_VERSION})
 set (minizip-ng_REFIND_ARGS REQUIRED)
+if (EXISTS "${_minizip-ng_CONFIG_DIR}/minizip-config.cmake")
+    file(READ "${_minizip-ng_CONFIG_DIR}/minizip-config.cmake" _mz_cfg)
+    string(REPLACE "find_dependency(BZip2)" "" _mz_cfg "${_mz_cfg}")
+    string(REPLACE "find_dependency(LibLZMA)" "" _mz_cfg "${_mz_cfg}")
+    string(REPLACE "find_dependency(zstd)" "" _mz_cfg "${_mz_cfg}")
+    string(REPLACE "find_dependency(OpenSSL)" "" _mz_cfg "${_mz_cfg}")
+    string(REPLACE "find_dependency(Iconv)" "" _mz_cfg "${_mz_cfg}")
+    file(WRITE "${_minizip-ng_CONFIG_DIR}/minizip-config.cmake" "${_mz_cfg}")
+endif()
+if (EXISTS "${_minizip-ng_CONFIG_DIR}/minizip-config.cmake"
+        AND NOT EXISTS "${_minizip-ng_CONFIG_DIR}/minizip-ng-config.cmake")
+    file(WRITE "${_minizip-ng_CONFIG_DIR}/minizip-ng-config.cmake"
+         "include(\"${CMAKE_CURRENT_LIST_DIR}/minizip-config.cmake\")\n"
+         "if(TARGET MINIZIP::minizip AND NOT TARGET MINIZIP::minizip-ng)\n"
+         "    add_library(MINIZIP::minizip-ng INTERFACE IMPORTED)\n"
+         "    set_target_properties(MINIZIP::minizip-ng PROPERTIES\n"
+         "        INTERFACE_LINK_LIBRARIES MINIZIP::minizip)\n"
+         "endif()\n")
+endif()
+if (EXISTS "${_minizip-ng_CONFIG_DIR}/minizip-config-version.cmake"
+        AND NOT EXISTS "${_minizip-ng_CONFIG_DIR}/minizip-ng-config-version.cmake")
+    file(WRITE "${_minizip-ng_CONFIG_DIR}/minizip-ng-config-version.cmake"
+         "include(\"${CMAKE_CURRENT_LIST_DIR}/minizip-config-version.cmake\")\n")
+endif()
+if (EXISTS "${_minizip-ng_LIB_DIR}/libminizip.a"
+        AND NOT EXISTS "${_minizip-ng_LIB_DIR}/libminizip-ng.a")
+    file(CREATE_LINK "${_minizip-ng_LIB_DIR}/libminizip.a"
+         "${_minizip-ng_LIB_DIR}/libminizip-ng.a" COPY_ON_ERROR)
+endif()
diff --git a/src/cmake/build_pystring.cmake b/src/cmake/build_pystring.cmake

<?xml version="1.0"?>
<materialx version="1.37">
  <standard_surface name="Tiled_Brass_SR_brass1" type="surfaceshader" version="1.0.1" xpos="315" ypos="34">
    <input name="base" type="float" value="1" uivisible="true" />

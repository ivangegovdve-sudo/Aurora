    <input name="metalness" type="float" value="1" uivisible="true" />
    <input name="specular" type="float" value="0" uivisible="true" />
    <input name="specular_roughness" type="float" nodename="image_roughness" uivisible="true" />
    <input name="coat" type="float" value="1" uivisible="true" />
  </standard_surface>
  <surfacematerial name="Tiled_Brass" type="material" xpos="620" ypos="10">
    <input name="surfaceshader" type="surfaceshader" nodename="Tiled_Brass_SR_brass1" uivisible="true" />
    <input name="displacementshader" type="displacementshader" value="" uivisible="true" />

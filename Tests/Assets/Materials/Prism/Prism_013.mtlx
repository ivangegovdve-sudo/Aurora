<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:layered name="PaintMetalFlakeRed_shader" type="surfaceshader">
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="surface_roughness" type="float" value="0" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="layered_f0" type="float" value="0.0602702" />
    <input name="layered_roughness" type="float" value="0.0774597" />
    <input name="layered_anisotropy" type="float" value="0" />
    <input name="layered_rotation" type="float" value="0" />
    <input name="layered_diffuse" type="color3" value="0.767376, 0.205984, 0.151704" colorspace="rec709_display" />
    <input name="layered_bottom_f0" type="color3" value="0.767376, 0.205984, 0.151704" colorspace="rec709_display" />
    <input name="layered_fraction" type="float" value="0.5" />
    <input name="layered_fraction_invert" type="boolean" value="true" />
    <input name="layered_normal" type="vector3" output="layered_normal_map_output" nodegraph="PaintMetalFlakeRed_inputGraph" />
  </adsk:layered>
  <surfacematerial name="PaintMetalFlakeRed" type="material" uiname="Prism-013">
    <input name="surfaceshader" type="surfaceshader" nodename="PaintMetalFlakeRed_shader" />
  </surfacematerial>
  <nodegraph name="PaintMetalFlakeRed_inputGraph">
    <adsk:normal_map name="layered_normal_texture" type="vector3">
      <input name="file" type="filename" value="PaintMetalFlakeRed/flakes.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="30, 30" unit="millimeter" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="normal_scale" type="float" value="1" />
    </adsk:normal_map>
    <output name="layered_normal_map_output" type="vector3" nodename="layered_normal_texture" />
  </nodegraph>
</materialx>

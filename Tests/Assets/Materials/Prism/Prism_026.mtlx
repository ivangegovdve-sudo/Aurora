<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:metal name="AluminumKnurled_shader" type="surfaceshader">
    <input name="metal_f0" type="color3" value="0.959822, 0.96226, 0.965052" colorspace="rec709_display" />
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="surface_roughness" type="float" value="0.264575" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="AluminumKnurled_inputGraph" />
  </adsk:metal>
  <surfacematerial name="AluminumKnurled" type="material" uiname="Prism-026">
    <input name="surfaceshader" type="surfaceshader" nodename="AluminumKnurled_shader" />
  </surfacematerial>
  <nodegraph name="AluminumKnurled_inputGraph">
    <adsk:normal_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="AluminumKnurled/texture_knurl_norm.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.25, 0.25" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="normal_scale" type="float" value="1" />
    </adsk:normal_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
  </nodegraph>
</materialx>

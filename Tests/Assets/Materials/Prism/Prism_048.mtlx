<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:metal name="CopperBrushedRadial_shader" type="surfaceshader">
    <input name="metal_f0" type="color3" value="0.93021, 0.806224, 0.765395" colorspace="rec709_display" />
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="surface_roughness" type="float" value="0.547723" />
    <input name="surface_anisotropy" type="float" value="0.85" />
    <input name="surface_rotation" type="float" output="surface_rotation_map_output" nodegraph="CopperBrushedRadial_inputGraph" />
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="CopperBrushedRadial_inputGraph" />
  </adsk:metal>
  <surfacematerial name="CopperBrushedRadial" type="material" uiname="Prism-048">
    <input name="surfaceshader" type="surfaceshader" nodename="CopperBrushedRadial_shader" />
  </surfacematerial>
  <nodegraph name="CopperBrushedRadial_inputGraph">
    <adsk:bitmap name="surface_rotation_texture" type="float">
      <input name="file" type="filename" value="CopperBrushedRadial/radial_stacked_anisdir.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="3, 3" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="surface_rotation_map_output" type="float" nodename="surface_rotation_texture" />
    <adsk:height_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="CopperBrushedRadial/brush_radial_stacked_bump.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="3, 3" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="depth" type="float" value="0.003" unit="inch" unittype="distance" />
      <input name="rotation_angle" type="float" value="0" />
    </adsk:height_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
  </nodegraph>
</materialx>

<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:transparent name="GlassClouds_shader" type="surfaceshader">
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="surface_roughness" type="float" value="0" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="GlassClouds_inputGraph" />
    <input name="transparent_ior" type="float" value="1.52" />
    <input name="transparent_color" type="color3" value="0.963976, 0.963976, 0.954687" colorspace="rec709_display" />
    <input name="transparent_distance" type="float" value="50" unit="millimeter" unittype="distance" />
  </adsk:transparent>
  <surfacematerial name="GlassClouds" type="material" uiname="Prism-159">
    <input name="surfaceshader" type="surfaceshader" nodename="GlassClouds_shader" />
  </surfacematerial>
  <nodegraph name="GlassClouds_inputGraph">
    <adsk:normal_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="GlassClouds/texture_glass_clouds_norm.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="2, 2" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="normal_scale" type="float" value="1" />
    </adsk:normal_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
  </nodegraph>
</materialx>

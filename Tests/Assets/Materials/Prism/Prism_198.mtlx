<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:transparent name="WaterCalmSea_shader" type="surfaceshader">
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="lin_rec709" />
    <input name="surface_roughness" type="float" output="surface_roughness_map_output" nodegraph="WaterCalmSea_inputGraph" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="WaterCalmSea_inputGraph" />
    <input name="transparent_ior" type="float" value="1.333" />
    <input name="transparent_color" type="color3" value="0.0273209, 0.141263, 0.119538" colorspace="lin_rec709" />
    <input name="transparent_distance" type="float" value="144" unit="inch" unittype="distance" />
  </adsk:transparent>
  <surfacematerial name="WaterCalmSea" type="material" uiname="Prism-198">
    <input name="surfaceshader" type="surfaceshader" nodename="WaterCalmSea_shader" />
  </surfacematerial>
  <nodegraph name="WaterCalmSea_inputGraph">
    <adsk:bitmap name="surface_roughness_texture" type="float">
      <input name="file" type="filename" value="WaterCalmSea/water_seacalm_rough.jpg" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="300, 300" unit="foot" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="surface_roughness_map_output" type="float" nodename="surface_roughness_texture" />
    <adsk:height_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="WaterCalmSea/water_seacalm_bump.jpg" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="300, 300" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="depth" type="float" value="6" unit="inch" unittype="distance" />
      <input name="rotation_angle" type="float" value="0" />
    </adsk:height_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
  </nodegraph>
</materialx>

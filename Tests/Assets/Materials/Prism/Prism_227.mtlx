<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:metal name="SteelMeshWireSmall_shader" type="surfaceshader">
    <input name="metal_f0" type="color3" value="0.62621, 0.62621, 0.62621" colorspace="rec709_display" />
    <input name="surface_albedo" type="color3" output="surface_albedo_map_output" nodegraph="SteelMeshWireSmall_inputGraph" />
    <input name="surface_roughness" type="float" value="0.122474" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="SteelMeshWireSmall_inputGraph" />
    <input name="surface_cutout" type="color3" output="surface_cutout_map_output" nodegraph="SteelMeshWireSmall_inputGraph" />
  </adsk:metal>
  <surfacematerial name="SteelMeshWireSmall" type="material" uiname="Prism-227">
    <input name="surfaceshader" type="surfaceshader" nodename="SteelMeshWireSmall_shader" />
  </surfacematerial>
  <nodegraph name="SteelMeshWireSmall_inputGraph">
    <adsk:bitmap name="surface_albedo_texture" type="color3">
      <input name="file" type="filename" value="SteelMeshWireSmall/mesh_wire_spec.png" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.25, 0.25" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="surface_albedo_map_output" type="color3" nodename="surface_albedo_texture" />
    <adsk:normal_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="SteelMeshWireSmall/mesh_wire_norm.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.25, 0.25" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="normal_scale" type="float" value="1" />
    </adsk:normal_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
    <adsk:bitmap name="surface_cutout_texture" type="color3">
      <input name="file" type="filename" value="SteelMeshWireSmall/mesh_wire_cutout.png" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.25, 0.25" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="surface_cutout_map_output" type="color3" nodename="surface_cutout_texture" />
  </nodegraph>
</materialx>

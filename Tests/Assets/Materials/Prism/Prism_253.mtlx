<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:opaque name="PlasticTexturedPolka_shader" type="surfaceshader">
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="PlasticTexturedPolka_inputGraph" />
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <!-- Dark teal instead of near-black grey: visually distinguishable from
         RubberWeathered and CarbonFiberTwill in the test grid. -->
    <input name="opaque_albedo" type="color3" value="0.04, 0.22, 0.28" colorspace="rec709_display" />
    <input name="surface_roughness" type="float" value="0.264575" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="opaque_f0" type="float" value="0.0529" />
    <input name="opaque_translucency" type="boolean" value="false" />
    <input name="opaque_mfp_modifier" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="opaque_mfp" type="float" value="0.5" unit="millimeter" unittype="distance" />
    <input name="opaque_emission" type="boolean" value="false" />
    <input name="opaque_luminance" type="float" value="0" />
    <input name="opaque_luminance_modifier" type="color3" value="1, 1, 1" colorspace="rec709_display" />
  </adsk:opaque>
  <surfacematerial name="PlasticTexturedPolka" type="material" uiname="Prism-253">
    <input name="surfaceshader" type="surfaceshader" nodename="PlasticTexturedPolka_shader" />
  </surfacematerial>
  <nodegraph name="PlasticTexturedPolka_inputGraph">
    <adsk:height_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="PlasticTexturedPolka/pattern06.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.25, 0.25" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="depth" type="float" value="0.002" unit="inch" unittype="distance" />
      <input name="rotation_angle" type="float" value="0" />
    </adsk:height_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
  </nodegraph>
</materialx>

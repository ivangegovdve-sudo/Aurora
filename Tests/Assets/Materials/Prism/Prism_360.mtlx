<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:opaque name="LeatherPerforatedYellow_shader" type="surfaceshader">
    <input name="surface_normal" type="vector3" output="surface_normal_map_output" nodegraph="LeatherPerforatedYellow_inputGraph" />
    <input name="surface_cutout" type="color3" output="surface_cutout_map_output" nodegraph="LeatherPerforatedYellow_inputGraph" />
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="opaque_albedo" type="color3" output="opaque_albedo_map_output" nodegraph="LeatherPerforatedYellow_inputGraph" />
    <input name="surface_roughness" type="float" output="surface_roughness_map_output" nodegraph="LeatherPerforatedYellow_inputGraph" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="opaque_f0" type="float" value="0.0277223" />
    <input name="opaque_translucency" type="boolean" value="false" />
    <input name="opaque_mfp_modifier" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="opaque_mfp" type="float" value="0.5" unit="millimeter" unittype="distance" />
    <input name="opaque_emission" type="boolean" value="false" />
    <input name="opaque_luminance" type="float" value="0" />
    <input name="opaque_luminance_modifier" type="color3" value="1, 1, 1" colorspace="rec709_display" />
  </adsk:opaque>
  <surfacematerial name="LeatherPerforatedYellow" type="material" uiname="Prism-360">
    <input name="surfaceshader" type="surfaceshader" nodename="LeatherPerforatedYellow_shader" />
  </surfacematerial>
  <nodegraph name="LeatherPerforatedYellow_inputGraph">
    <adsk:height_map name="surface_normal_texture" type="vector3">
      <input name="file" type="filename" value="LeatherPerforatedYellow/leather_perforated_bump.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="8, 8" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="depth" type="float" value="0.01" unit="inch" unittype="distance" />
      <input name="rotation_angle" type="float" value="0" />
    </adsk:height_map>
    <output name="surface_normal_map_output" type="vector3" nodename="surface_normal_texture" />
    <adsk:bitmap name="surface_cutout_texture" type="color3">
      <input name="file" type="filename" value="LeatherPerforatedYellow/leather_perforated_cutout.png" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="8, 8" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="surface_cutout_map_output" type="color3" nodename="surface_cutout_texture" />
    <adsk:bitmap name="opaque_albedo_texture" type="color3">
      <input name="file" type="filename" value="LeatherPerforatedYellow/leather_colors_yellow.jpg" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="8, 8" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="opaque_albedo_map_output" type="color3" nodename="opaque_albedo_texture" />
    <adsk:bitmap name="surface_roughness_texture" type="float">
      <input name="file" type="filename" value="LeatherPerforatedYellow/leather_matte_rough.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="8, 8" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="surface_roughness_map_output" type="float" nodename="surface_roughness_texture" />
  </nodegraph>
</materialx>

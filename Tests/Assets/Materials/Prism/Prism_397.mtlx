<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:opaque name="MarbleTranslucent_shader" type="surfaceshader">
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="opaque_albedo" type="color3" output="opaque_albedo_map_output" nodegraph="MarbleTranslucent_inputGraph" />
    <!-- Increased roughness so the diffuse/SSS component is visible over specular. -->
    <input name="surface_roughness" type="float" value="0.45" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="opaque_f0" type="float" value="0.0277223" />
    <input name="opaque_translucency" type="boolean" value="true" />
    <!-- Saturated warm pink so the SSS glow is unmistakably visible in test renders;
         real Carrara marble has a warm-cream SSS tint but it is too subtle at 128 PT
         iterations on a near-white albedo to verify automatically. -->
    <input name="opaque_mfp_modifier" type="color3" value="1.0, 0.55, 0.40" colorspace="rec709_display" />
    <input name="opaque_mfp" type="float" value="0.45" unit="millimeter" unittype="distance" />
    <input name="opaque_emission" type="boolean" value="false" />
    <input name="opaque_luminance" type="float" value="0" />
    <input name="opaque_luminance_modifier" type="color3" value="1, 1, 1" colorspace="rec709_display" />
  </adsk:opaque>
  <surfacematerial name="MarbleTranslucent" type="material" uiname="Prism-397">
    <input name="surfaceshader" type="surfaceshader" nodename="MarbleTranslucent_shader" />
  </surfacematerial>
  <nodegraph name="MarbleTranslucent_inputGraph">
    <adsk:bitmap name="opaque_albedo_texture" type="color3">
      <input name="file" type="filename" value="MarbleTranslucent/marble_white.jpg" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="24, 24" unit="inch" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="opaque_albedo_map_output" type="color3" nodename="opaque_albedo_texture" />
  </nodegraph>
</materialx>

<?xml version="1.0"?>
<materialx version="1.38">
  <adsk:opaque name="ATypeBulbFrosted800lm_shader" type="surfaceshader">
    <input name="surface_albedo" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <!-- Saturated amber: makes the bulb obviously warm/golden rather than near-white. -->
    <input name="opaque_albedo" type="color3" value="0.95, 0.55, 0.10" colorspace="rec709_display" />
    <input name="surface_roughness" type="float" value="0.5" />
    <input name="surface_anisotropy" type="float" value="0" />
    <input name="surface_rotation" type="float" value="0" />
    <input name="opaque_f0" type="float" value="0.0676" />
    <input name="opaque_translucency" type="boolean" value="false" />
    <input name="opaque_mfp_modifier" type="color3" value="1, 1, 1" colorspace="rec709_display" />
    <input name="opaque_mfp" type="float" value="0.5" unit="millimeter" unittype="distance" />
    <input name="opaque_emission" type="boolean" value="true" />
    <input name="opaque_luminance" type="float" value="10200" />
    <!-- Warm incandescent colour temperature (~2700 K) instead of pure white so the
         emission is visually distinct from the near-white frosted-glass albedo. -->
    <input name="opaque_luminance_modifier" type="color3" value="1.0, 0.75, 0.35" colorspace="rec709_display" />
  </adsk:opaque>
  <surfacematerial name="ATypeBulbFrosted800lm" type="material" uiname="Prism-414">
    <input name="surfaceshader" type="surfaceshader" nodename="ATypeBulbFrosted800lm_shader" />
  </surfacematerial>
</materialx>
